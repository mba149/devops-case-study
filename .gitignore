.DS_Store
.env
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/

# OpenTofu local state and downloaded providers.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
*.auto.tfvars

# Keep the reviewed example render, but ignore environment-specific output.
kops/generated/*
!kops/generated/example.yaml
.kops-state/

# Ansible runtime data and generated Helm environment values.
ansible/.ansible/
helm/environments/*-generated.yaml
