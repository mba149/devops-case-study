apiVersion: kops.k8s.io/v1alpha2
kind: InstanceGroup
metadata:
  labels:
    kops.k8s.io/cluster: {{ .clusterName }}
  name: workers-ondemand-us-east-1a
spec:
  autoscale: true
  cloudLabels:
    capacity-profile: on-demand
  image: 099720109477/ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-20260610
  machineType: m7i.large
  maxSize: {{ .workers.ondemand.maxSize }}
  minSize: {{ .workers.ondemand.minSize }}
  nodeLabels:
    capacity-profile: on-demand
    kops.k8s.io/instancegroup: workers-ondemand-us-east-1a
  role: Node
  subnets:
    - us-east-1a
