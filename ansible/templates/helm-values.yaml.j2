# Generated by Ansible for {{ deployment_environment }}. Do not edit manually.
image:
  repository: {{ application_image_repository | to_json }}
  tag: {{ application_image_tag | to_json }}
  pullPolicy: {{ application_image_pull_policy | to_json }}

aws:
  region: {{ aws_region | to_json }}
  bucket: {{ s3_bucket | to_json }}
  prefix: {{ s3_prefix | to_json }}
  credentialsSecretName: {{ aws_credentials_secret_name | to_json }}

autoscaling:
  enabled: {{ autoscaling_enabled | bool | lower }}
  minReplicas: {{ autoscaling_min_replicas }}
  maxReplicas: {{ autoscaling_max_replicas }}
  targetCPUUtilizationPercentage: {{ autoscaling_target_cpu_utilization }}

resources:
  app:
    requests:
      cpu: {{ app_cpu_request | to_json }}
      memory: {{ app_memory_request | to_json }}
    limits:
      memory: {{ app_memory_limit | to_json }}
  nginx:
    requests:
      cpu: {{ nginx_cpu_request | to_json }}
      memory: {{ nginx_memory_request | to_json }}
    limits:
      memory: {{ nginx_memory_limit | to_json }}
